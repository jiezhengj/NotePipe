{
  "name": "notepipe",
  "version": "0.1.4",
  "description": "Copy text from Obsidian with file path and line number context — ready for AI agent terminals.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate-release": "node tools/validate-release.mjs",
    "release:prepare": "npm run build && npm run validate-release"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "claude",
    "context"
  ],
  "author": "jiezhengj",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/view": "^6.0.0",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.5.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
